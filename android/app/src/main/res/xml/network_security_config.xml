<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- App kiosk em rede local: permite HTTP para alcançar dispositivos
         locais como ESP32/fechaduras que não têm certificado SSL. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
